  "findings": [
    {
      "confidence": "confirmed",
      "evidence": [
        "AndroidManifest.xml declares android.permission.INTERNET."
      ],
      "id": "APK-001",
      "impact": "The native connector and game socket can communicate with remote endpoints.",
      "limit": "This is expected for an online game and does not identify a vulnerable endpoint by itself.",
      "severity": "context",
      "title": "The application has network access"
    },
    {
      "confidence": "confirmed",
      "evidence": [
        "AndroidManifest.xml sets android:usesCleartextTraffic=true."
      ],
      "id": "APK-002",
      "impact": "Android framework HTTP clients are not blocked by the manifest policy.",
      "limit": "The connector has its own native TLS implementation, so this does not prove that login uses cleartext.",
      "severity": "medium",
      "title": "The manifest permits cleartext traffic"
    },
    {
      "confidence": "confirmed capability, exploitability untested",
      "evidence": [
        "An exported component accepts graalclassic:// or graalclassicplus:// intent data."
      ],
      "id": "APK-003",
      "impact": "Any installed application can request the activity, so URI action, data, and extras are an input boundary.",
      "limit": "This audit did not send a malicious intent or claim code execution from the URI alone.",
      "severity": "medium",
      "title": "An exported activity accepts custom Graal URI schemes"
    },
    {
      "confidence": "confirmed capability, path boundaries reviewed locally",
      "evidence": [
        "DEX strings include WebView, setJavaScriptEnabled, and addJavascriptInterface. Local smali review places the game WebView in QPlayActivity and the bridge call in the bundled Bolts app-link resolver."
      ],
      "id": "APK-004",
      "impact": "QPlayActivity can load native-supplied URLs with JavaScript enabled. The separate Bolts resolver exposes a narrow JSON metadata bridge, so both paths deserve input and navigation review.",
      "limit": "Static review does not prove that a remote page can reach the game WebView, the Bolts resolver, or every bridge method in a production run.",
      "severity": "high-interest",
      "title": "The Java layer contains separate JavaScript-enabled WebView surfaces"
    },
    {
      "confidence": "confirmed capability, command reachability untested",
      "evidence": [
        "DEX strings include DexClassLoader, load_dex, and java_reflection."
      ],
      "id": "APK-005",
      "impact": "If untrusted content can supply those commands, code can be loaded inside the application process with its permissions.",
      "limit": "The audit did not inject DEX, invoke reflection, or contact the recovered WebTop URL.",
      "severity": "high-interest",
      "title": "The WebTop code contains a DEX loading and reflection path"
    },
    {
      "confidence": "confirmed legacy vocabulary, active suite selection unproven",
      "evidence": [
        "libqplay.so contains RC4 and NULL cipher identifiers and TLS version strings."
      ],
      "id": "APK-006",
      "impact": "If enabled by negotiation or configuration, legacy suites increase downgrade and confidentiality risk.",
      "limit": "String presence does not show that a weak suite was negotiated. Separate IDA review found peer and hostname verification in the connector path.",
      "severity": "medium",
      "title": "The bundled native TLS implementation contains legacy cipher names"
    },
    {
      "confidence": "confirmed embedded legacy material, active trust use unproven",
      "evidence": [
        "res/raw/fabzat_com.crt is a PEM certificate for admin.fabzat.com.",
        "Its recorded validity ends at 2014-08-23T05:22:41 and its signature hash is sha1."
      ],
      "id": "APK-007",
      "impact": "Any code that treats this file as a trust anchor or pinned service certificate cannot validate a current service chain after expiry.",
      "limit": "The file's presence does not prove that startup or login consumes it. No live request was made.",
      "severity": "medium",
      "title": "The APK carries an expired Fabzat certificate"
    },
    {
      "confidence": "confirmed embedded bundle, active validation path separately reviewed",
      "evidence": [
        "The ARM64 library contains 1472 bytes of trust text at file offset 3058144 with SHA-256 eab759c34c8bc2f323eff8e152b1cc5cbcf6031ace48ca519a528ff0e327f142."
      ],
      "id": "APK-008",
      "impact": "A connector that still validates only against this bundle can fail after a service certificate renewal.",
      "limit": "The report does not claim that every native connection uses the bundle or that replacing it is safe without an authorized current chain.",
      "severity": "medium",
      "title": "The native library embeds a fixed connector trust bundle"
    },
    {
      "confidence": "confirmed",
      "evidence": [
        "readelf reports non-executable GNU_STACK program headers for the packaged shared libraries."
      ],
      "id": "APK-010",
      "impact": "This is a useful mitigation against one class of memory corruption exploit.",
      "limit": "It does not establish full RELRO, complete control-flow integrity, or safe input handling.",
      "severity": "informational",
      "title": "Packaged native libraries do not request an executable stack"
    },
    {
      "confidence": "confirmed static compatibility lead",
      "evidence": [
        "Every packaged libqplay.so declares NEEDED libstdc++.so, while the APK contains no libstdc++.so file.",
        "ELF LOAD alignment is 0x10000 for ARM64 and 0x1000 for the other packaged ABIs."
      ],
      "id": "APK-012",
      "impact": "On an Android image that does not provide a compatible libstdc++.so, the dynamic linker can reject libqplay.so before JNI startup. That can look like an offline or non-connecting application.",
      "limit": "This is a loader-compatibility hypothesis, not a confirmed failure. The local replay loaded the x86_64 variant, and no ARM64 device logcat was available. The alignment values do not by themselves identify a fault.",
      "severity": "low",
      "title": "Native libraries depend on an unbundled legacy C++ runtime SONAME"
    },
    {
      "confidence": "confirmed static capability, runtime reachability untested",
      "evidence": [
        "The APK contains lib/arm64-v8a/libxposed.so.",
        "The companion ELF imports dlopen, dlsym, and mprotect and contains markers for libqplay.so, pthread_create, and an inline-hook status message."
      ],
      "id": "CMP-001",
      "impact": "A companion library with this surface can resolve the game library and modify executable pages, so its presence changes the trust boundary and invalidates direct stock-behavior comparisons.",
      "limit": "This pass did not load or execute the library and does not claim that every hook runs on every device. The detailed static target review is recorded in docs/ABI_2_2_COMPARISON.md.",
      "severity": "high-interest",
      "title": "The comparison package includes a native library that can alter qplay at runtime"
    }
  ],
